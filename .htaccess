# cPanel / Apache config for the static export of the TKC Talent site.
# Maps pretty URLs like /about → /about.html, falls back to /404.html.

Options -MultiViews
DirectoryIndex index.html

# Output uses subfolder/index.html, so Apache's DirectoryIndex resolves
# pretty URLs like /book-alia-bhatt → /book-alia-bhatt/index.html natively.
# We add an explicit rewrite as a safety net for hosts where the prerender
# emitted /book-alia-bhatt.html instead of a folder, then fall through to
# /404.html for anything that genuinely doesn't exist.
#
# IMPORTANT — never RewriteRule directly to /404.html. That would serve the
# 404 body with HTTP 200, which Google treats as a "soft 404". We rely on
# Apache's ErrorDocument below so the response keeps the real 404 status.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonicalize hostname: always redirect www → apex (non-www).
  # Google should only ever see one hostname; serving the same content
  # at both www and apex creates duplicate-content / indexing confusion.
  RewriteCond %{HTTP_HOST} ^www\.tkctalent\.com$ [NC]
  RewriteRule ^(.*)$ https://tkctalent.com/$1 [R=301,L]

  # 301 redirect: old /celebrity-charges URL → new /bollywood-celebrity-charges
  RewriteRule ^celebrity-charges/?$ /bollywood-celebrity-charges [R=301,L]

  # 301 redirects for GSC-flagged 404s (missing rosters / dated slug).
  # These URLs were indexed / linked externally but never had matching pages;
  # send visitors to the closest live hub instead of returning a soft 404.
  RewriteRule ^book-jr-ntr/?$          /celebrity-booking-india [R=301,L]
  RewriteRule ^book-tovino-thomas/?$   /celebrity-booking-india [R=301,L]
  RewriteRule ^book-vijay-sethupathi/?$ /celebrity-booking-india [R=301,L]
  RewriteRule ^celebrity-charges-2026/?$ /bollywood-celebrity-charges [R=301,L]

  # 301 redirects for retired singer booking pages → singer hub.
  # Close topical match, so Google passes link equity instead of soft-404ing.
  RewriteRule ^book-sunidhi-chauhan/?$ /singer-booking-india/ [R=301,L]
  RewriteRule ^book-asees-kaur/?$ /singer-booking-india/ [R=301,L]

  # 301 redirects for retired artist booking pages → nearest matching hub.
  RewriteRule ^book-arijit-singh/?$ /singer-booking-india/ [R=301,L]
  RewriteRule ^book-badshah/?$ /singer-booking-india/ [R=301,L]
  RewriteRule ^book-kapil-sharma/?$ /comedian-booking-india/ [R=301,L]

  # Canonical URL form: always use a trailing slash for directory routes.
  # If the request maps to an existing directory but is missing the trailing
  # slash (e.g. /book-vaani-kapoor), 301 redirect to the slashed form.
  # Preserves the query string and skips real files (so /sitemap.xml,
  # /robots.txt, /llms.txt, /favicon.ico, /assets/* etc. are untouched).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !(/$)
  RewriteRule ^(.+)$ /$1/ [R=301,L]

  # If the request isn't a real file/folder, try appending .html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]

  # Anything still unresolved (no real file, no .html sibling, no folder)
  # falls through to Apache, which sends ErrorDocument 404 /404.html below
  # with the correct 404 status code.
</IfModule>

# ErrorDocument with a local path preserves the 404 status code while
# serving the styled /404.html body. Do NOT use a Redirect or absolute URL
# here — both would change the status to 200 or 302.
ErrorDocument 404 /404.html

# Belt-and-braces: tell crawlers not to index the 404 page itself.
<IfModule mod_headers.c>
  <Files "404.html">
    Header set X-Robots-Tag "noindex"
  </Files>
</IfModule>

# Long-cache hashed assets, never cache HTML.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2?|ttf|otf|eot|png|jpe?g|gif|svg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Service workers must revalidate so cache fixes reach installed visitors.
  <Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Service-Worker-Allowed "/"
  </Files>
</IfModule>

# Gzip / Brotli where available.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>
# HSTS — force HTTPS for 2 years, include subdomains (SEO/security best practice).
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# RFC 8288 Link response headers — point AI agents at discovery resources.
# Emitted on every HTML response so crawlers that don't parse <head> still
# find the API catalog and service documentation.  Only IANA-registered
# relation types recognized by agent scanners are used.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header append Link "</.well-known/api-catalog>; rel=\"api-catalog\"; type=\"application/linkset+json\""
    Header append Link "</llms.txt>; rel=\"service-doc\"; type=\"text/markdown\""
  </FilesMatch>
</IfModule>

# Serve extensionless /.well-known/api-catalog with the linkset+json type.
<IfModule mod_headers.c>
  <Files "api-catalog">
    Header set Content-Type "application/linkset+json"
  </Files>
</IfModule>

# BEGIN GENERATED GALLERY IMAGE REDIRECTS
Redirect 301 /actresses/sonakshi-singha.png /actresses/sonakshi-sinha.png
# END GENERATED GALLERY IMAGE REDIRECTS
