{
  "$schema": "https://modelcontextprotocol.io/schema/server-card.json",
  "serverInfo": {
    "name": "tkc-talent-site",
    "version": "1.0.0",
    "title": "TKC Talent site discovery",
    "description": "Read-only discovery card for TKC Talent's public website. No live MCP transport is currently exposed; clients should treat the listed resources as the authoritative content surface."
  },
  "capabilities": {
    "resources": { "listChanged": false },
    "tools": {},
    "prompts": {}
  },
  "resources": [
    {
      "uri": "https://tkctalent.com/llms.txt",
      "name": "Site overview for LLMs",
      "mimeType": "text/markdown"
    },
    {
      "uri": "https://tkctalent.com/sitemap.xml",
      "name": "Sitemap",
      "mimeType": "application/xml"
    },
    {
      "uri": "https://tkctalent.com/.well-known/api-catalog",
      "name": "API catalog (RFC 9727)",
      "mimeType": "application/linkset+json"
    },
    {
      "uri": "https://tkctalent.com/llms-full.txt",
      "name": "Full grounding corpus",
      "mimeType": "text/plain"
    },
    {
      "uri": "https://tkctalent.com/.well-known/agent-skills/index.json",
      "name": "Agent skills index",
      "mimeType": "application/json"
    },
    {
      "uri": "https://tkctalent.com/.well-known/agent-skills/artist-catalog.json",
      "name": "Artist catalog (machine-readable roster)",
      "mimeType": "application/json"
    },
    {
      "uri": "https://tkctalent.com/.well-known/agent-skills/request-quote.md",
      "name": "Quote-request skill",
      "mimeType": "text/markdown"
    }
  ]
}